
/* =========================================
   STUDY HUB — GREEN & BLACK DESIGN
   ========================================= */

:root {
    --bg: #07110c;
    --surface: #101b14;
    --surface-2: #16251b;
    --green: #b5f36b;
    --green-dark: #75bd42;
    --white: #f3f7f0;
    --muted: #a3b1a5;
    --border: rgba(181, 243, 107, 0.15);
    --danger: #ff7777;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--white);
    line-height: 1.6;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

::selection {
    background: var(--green);
    color: var(--bg);
}

/* NAVIGATION */

.nav {
    width: 100%;
    min-height: 80px;
    padding: 20px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    background: rgba(7, 17, 12, 0.95);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(15px);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px;
    font-weight: 700;
}

.brand > span:not(.logo) {
    color: var(--green);
}

.logo {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    background: var(--green);
    color: var(--bg);
    border-radius: 9px;
    font-weight: 800;
    margin-right: 5px;
}

.nav nav {
    display: flex;
    gap: 35px;
}

.nav nav a {
    color: var(--muted);
    font-size: 14px;
    transition: 0.3s;
}

.nav nav a:hover {
    color: var(--green);
}

.nav-link {
    border: 1px solid var(--border);
    padding: 10px 18px;
    border-radius: 30px;
    font-size: 14px;
    transition: 0.3s;
}

.nav-link:hover {
    background: var(--green);
    color: var(--bg);
}

.nav-link b {
    color: var(--green);
    margin-left: 5px;
}

/* HERO */

.hero {
    padding: 100px 8% 90px;
    min-height: 600px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 60px;
    position: relative;
}

.hero-copy {
    max-width: 650px;
}

.eyebrow {
    color: var(--green);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
}

.eyebrow i,
.tag i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    display: inline-block;
    box-shadow: 0 0 12px var(--green);
}

.hero h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(55px, 7vw, 95px);
    line-height: 1.05;
    letter-spacing: -4px;
    margin: 25px 0;
}

.hero h1 em {
    font-style: normal;
    color: var(--green);
}

.hero-copy > p {
    max-width: 500px;
    color: var(--muted);
    font-size: 17px;
    margin-bottom: 35px;
}

.actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    padding: 15px 22px;
    border-radius: 9px;
    border: 1px solid transparent;
    font-weight: 700;
    font-size: 14px;
    transition: 0.3s;
}

.btn.primary {
    background: var(--green);
    color: #07110c;
}

.btn.primary:hover {
    background: #d0ff9b;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(181, 243, 107, 0.15);
}

.btn.ghost {
    border-color: var(--border);
    color: var(--white);
    background: transparent;
}

.btn.ghost:hover {
    border-color: var(--green);
    color: var(--green);
}

.made {
    color: var(--muted);
    font-size: 12px;
    margin-top: 45px;
}

/* HERO ART */

.art {
    min-height: 430px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 25px;
    background:
        radial-gradient(circle at 50% 50%,
        rgba(119, 186, 70, 0.15),
        transparent 65%),
        linear-gradient(145deg, #122018, #07110c);
}

.ring {
    position: absolute;
    border: 1px solid rgba(181, 243, 107, 0.13);
    border-radius: 50%;
}

.ring1 {
    width: 330px;
    height: 330px;
}

.ring2 {
    width: 450px;
    height: 450px;
}

.book {
    position: relative;
    display: flex;
    transform: rotate(-8deg);
    z-index: 2;
    filter: drop-shadow(0 25px 30px rgba(0, 0, 0, 0.4));
}

.book-side {
    width: 55px;
    height: 270px;
    background: #15251b;
    color: var(--green);
    padding: 25px 10px;
    font-size: 11px;
    border: 1px solid #304c35;
    writing-mode: vertical-rl;
    text-align: center;
    letter-spacing: 2px;
}

.book-side strong {
    font-size: 23px;
}

.cover {
    width: 210px;
    height: 270px;
    background: var(--green);
    color: #07110c;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 0 8px 8px 0;
}

.cover b {
    font-size: 40px;
    font-family: 'Space Grotesk', sans-serif;
}

.cover strong {
    font-size: 30px;
    line-height: 1.1;
    font-family: 'Space Grotesk', sans-serif;
}

.cover small {
    font-size: 9px;
    letter-spacing: 1px;
}

.tag {
    position: absolute;
    background: #101b14;
    border: 1px solid var(--border);
    border-radius: 30px;
    padding: 12px 16px;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--white);
    z-index: 3;
}

.tag1 {
    top: 50px;
    left: 20px;
}

.tag2 {
    bottom: 45px;
    right: 20px;
}

.spark {
    position: absolute;
    color: var(--green);
    font-size: 40px;
    top: 80px;
    right: 70px;
}

/* STATS */

.stats {
    padding: 35px 8%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: #0b160f;
}

.stats > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.stats > div b {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 35px;
    color: var(--green);
}

.stats > div span {
    font-size: 13px;
    color: var(--muted);
}

.stats > p {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--muted);
    padding-top: 15px;
    border-top: 1px solid var(--border);
}

/* LIBRARY */

.section {
    padding: 100px 8%;
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 35px;
}

.section h2,
.upload-area h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(35px, 5vw, 55px);
    line-height: 1.15;
    letter-spacing: -2px;
    margin-top: 15px;
}

.section h2 span,
.upload-area h2 span {
    color: var(--green);
}

.count {
    color: var(--green);
    font-size: 11px;
    letter-spacing: 1px;
    border: 1px solid var(--border);
    padding: 10px 15px;
    border-radius: 30px;
}

/* SEARCH */

.search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    margin-bottom: 35px;
}

.search > span {
    color: var(--green);
    font-size: 25px;
}

.search input {
    flex: 1;
    min-width: 100px;
    border: none;
    outline: none;
    background: transparent;
    color: var(--white);
    padding: 8px;
}

.search select {
    background: var(--surface-2);
    color: var(--white);
    border: 1px solid var(--border);
    padding: 10px;
    border-radius: 8px;
    outline: none;
}

.search button {
    border: none;
    background: var(--green);
    color: var(--bg);
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 700;
    transition: 0.3s;
}

.search button:hover {
    background: #d0ff9b;
}

/* EMPTY LIBRARY */

.empty {
    text-align: center;
    padding: 90px 25px;
    border: 1px dashed rgba(181, 243, 107, 0.25);
    border-radius: 20px;
    background: var(--surface);
}

.plus {
    width: 65px;
    height: 65px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    margin: 0 auto 25px;
    background: rgba(181, 243, 107, 0.08);
    color: var(--green);
    font-size: 30px;
    border: 1px solid var(--border);
}

.empty .eyebrow {
    justify-content: center;
}

.empty h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 30px;
    margin: 15px 0;
}

.empty p {
    color: var(--muted);
    max-width: 500px;
    margin: 0 auto 30px;
    font-size: 14px;
}

/* MATERIAL CARDS */

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.material {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 25px;
    border-radius: 16px;
    transition: 0.3s;
}

.material:hover {
    border-color: rgba(181, 243, 107, 0.5);
    transform: translateY(-5px);
    background: var(--surface-2);
}

.file {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: rgba(181, 243, 107, 0.1);
    color: var(--green);
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 20px;
}

.meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--green);
    font-size: 12px;
}

.meta small {
    color: var(--muted);
}

.material h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    margin: 15px 0;
}

.material p {
    font-size: 13px;
    color: var(--muted);
    min-height: 55px;
    word-break: break-word;
}

.card-foot {
    border-top: 1px solid var(--border);
    padding-top: 20px;
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.card-foot small {
    color: var(--muted);
}

.card-foot a {
    color: var(--green);
    font-size: 13px;
    font-weight: 700;
}

/* FLASH MESSAGES */

.flash {
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-size: 14px;
}

.flash.success {
    background: rgba(181, 243, 107, 0.1);
    border: 1px solid var(--green);
    color: var(--green);
}

.flash.error {
    background: rgba(255, 119, 119, 0.1);
    border: 1px solid var(--danger);
    color: var(--danger);
}

/* UPLOAD SECTION */

.upload-area {
    padding: 100px 8%;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 70px;
    align-items: start;
    background:
        radial-gradient(circle at 10% 10%,
        rgba(181, 243, 107, 0.06),
        transparent 40%),
        #0b160f;
    border-top: 1px solid var(--border);
}

.intro > p {
    color: var(--muted);
    margin-top: 25px;
    max-width: 450px;
    font-size: 15px;
}

.intro aside {
    display: flex;
    gap: 15px;
    align-items: start;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    margin-top: 35px;
    color: var(--green);
}

.intro aside div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.intro aside small {
    color: var(--muted);
    font-size: 12px;
}

.upload-form {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 35px;
}

.form-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 15px;
    margin-bottom: 30px;
}

.form-head h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 25px;
    margin-top: 10px;
}

.form-head > small {
    color: var(--green);
    font-size: 11px;
}

.upload-form > label:not(.drop) {
    display: block;
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 20px;
}

.upload-form input:not([type="file"]),
.upload-form textarea {
    display: block;
    width: 100%;
    background: #08120c;
    color: var(--white);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 14px;
    outline: none;
    margin-top: 8px;
    resize: vertical;
    transition: 0.3s;
}

.upload-form input:focus,
.upload-form textarea:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(181, 243, 107, 0.05);
}

.upload-form input::placeholder,
.upload-form textarea::placeholder {
    color: #627267;
}

.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.two label {
    color: var(--muted);
    font-size: 13px;
}

.drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 30px 20px;
    border: 1px dashed rgba(181, 243, 107, 0.4);
    border-radius: 12px;
    background: rgba(181, 243, 107, 0.03);
    margin: 25px 0;
    cursor: pointer;
    transition: 0.3s;
}

.drop:hover {
    border-color: var(--green);
    background: rgba(181, 243, 107, 0.08);
}

.drop .up {
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    background: rgba(181, 243, 107, 0.1);
    border-radius: 12px;
    color: var(--green);
    font-size: 24px;
}

.drop strong {
    font-size: 14px;
    word-break: break-word;
}

.drop small {
    color: var(--muted);
    font-size: 11px;
}

.drop input[type="file"] {
    width: 100%;
    max-width: 100%;
    color: var(--muted);
    font-size: 12px;
}

.submit {
    width: 100%;
    border: none;
    margin-top: 5px;
}

.disclaimer {
    display: block;
    text-align: center;
    color: var(--muted);
    font-size: 11px;
    margin-top: 20px;
}

/* FOOTER */

footer {
    padding: 30px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    border-top: 1px solid var(--border);
}

footer small {
    color: var(--muted);
    font-size: 12px;
}

footer > a:last-child {
    color: var(--green);
    font-size: 13px;
}

/* RESPONSIVE DESIGN */

@media (max-width: 1000px) {
    .hero {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .art {
        min-height: 400px;
    }

    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .upload-area {
        grid-template-columns: 1fr;
        gap: 45px;
    }
}

@media (max-width: 700px) {
    .nav {
        padding: 15px 5%;
    }

    .nav nav {
        gap: 15px;
    }

    .nav nav a {
        font-size: 12px;
    }

    .nav-link {
        display: none;
    }

    .hero {
        padding: 65px 5%;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero-copy > p {
        font-size: 15px;
    }

    .art {
        min-height: 350px;
    }

    .cover {
        width: 170px;
        height: 230px;
        padding: 25px;
    }

    .cover strong {
        font-size: 24px;
    }

    .book-side {
        height: 230px;
        width: 45px;
    }

    .tag {
        font-size: 9px;
        padding: 10px;
    }

    .ring1 {
        width: 270px;
        height: 270px;
    }

    .ring2 {
        width: 350px;
        height: 350px;
    }

    .stats {
        padding: 30px 5%;
        gap: 15px;
    }

    .stats > div b {
        font-size: 28px;
    }

    .stats > div span {
        font-size: 11px;
    }

    .section {
        padding: 65px 5%;
    }

    .section-head {
        flex-direction: column;
        align-items: start;
    }

    .search {
        flex-wrap: wrap;
    }

    .search input {
        flex-basis: 65%;
    }

    .search select {
        flex: 1;
        min-width: 100px;
    }

    .search button {
        width: 100%;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .upload-area {
        padding: 65px 5%;
    }

    .upload-form {
        padding: 25px 20px;
    }

    .two {
        grid-template-columns: 1fr;
    }

    footer {
        padding: 25px 5%;
        flex-wrap: wrap;
    }

    footer small {
        order: 3;
        width: 100%;
    }
}

@media (max-width: 400px) {
    .nav nav {
        gap: 10px;
    }

    .brand {
        font-size: 18px;
    }

    .hero h1 {
        font-size: 53px;
    }

    .actions .btn {
        width: 100%;
    }

    .art {
        min-height: 300px;
    }
}
